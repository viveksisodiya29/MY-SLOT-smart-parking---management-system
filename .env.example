# ===============================================================================
# MY-SLOT Environment Configuration Template
# Copy this file to .env and configure the values for your deployment environment.
# ===============================================================================

# Node / Express Server Port (defaults to 3000)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=production

# Python Backend Port (defaults to 5001)
PYTHON_PORT=5001

# Command or path to Python executable (defaults to 'python3' on Linux, 'python' on Windows)
# PYTHON=python3

# Persistent SQLite database location (mount a Docker volume or persistent disk here)
DATABASE_PATH=./backend/MY-SLOT.db

# ------------------------------------------------------------------------------
# Security & Authentication (Required for Production)
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign JWT session tokens (generate a 32+ character random string)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# Secret passcode required during registration to obtain the 'admin' role
ADMIN_SECRET_KEY="ADMIN@1812"

# In production, set to 'false' so arbitrary users cannot self-promote to admin if database is empty
ALLOW_BOOTSTRAP_ADMIN=false

# Allowed CORS origins ('*' or comma-separated URLs like 'https://my-slot.example.com')
CORS_ORIGIN=*

# Google Maps JavaScript API key (enable Maps JavaScript API and restrict by website referrer)
VITE_GOOGLE_MAPS_API_KEY=

# Public URL of the separately deployed MY-SLOT API (leave blank for local development)
# Example: https://my-slot-api.onrender.com
VITE_API_BASE_URL="https://my-slot-backend.onrender.com"

# ------------------------------------------------------------------------------
# Real Payment Processing (Stripe)
# ------------------------------------------------------------------------------
# Provide your live or test secret key from the Stripe Dashboard (starts with sk_test_ or sk_live_).
# If omitted or left blank, MY-SLOT runs in safe sandbox simulation mode.
STRIPE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Real Email Delivery (SMTP: SendGrid, Brevo, AWS SES, Gmail, etc.)
# ------------------------------------------------------------------------------
# If omitted or left blank, notifications are stored locally and visible via the in-app Email Inbox modal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bookings@my-slot.app
SMTP_USE_TLS=true
